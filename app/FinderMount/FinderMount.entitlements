<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  A File Provider extension must be sandboxed. It needs nothing else: the phone is reached
	  through the adb server on 127.0.0.1:5037 (the app starts it), which is a plain outbound
	  loopback connection.
	-->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ai.rplay.rplayhub</string>
	</array>
</dict>
</plist>
