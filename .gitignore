.DS_Store

# Build output
build/
app/build/
linux/build/
linux/third_party/
imgui.ini

# Xcode
*.xcuserdatad/
xcuserdata/
*.xcworkspace/xcuserdata/

# Gradle, inside the vendored agent tree. The source is ours to keep; what it builds is not.
refs/studio/screen-sharing-agent/local.properties
refs/studio/screen-sharing-agent/.gradle/
refs/studio/screen-sharing-agent/.kotlin/
refs/studio/screen-sharing-agent/build/
refs/studio/screen-sharing-agent/app/build/
refs/studio/screen-sharing-agent/app/.cxx/

# Intermediate for the icon; AppIcon.icns is the built artefact and is tracked.
app/rPlayHubAndroid/AppIcon.iconset/

# Session working notes — carry device addresses and machine-local details; never publish.
doc/HANDOFF.md
doc/NEXT-PROMPT.txt

# Demo recordings — large, and camera captures can carry GPS/EXIF. Keep them out of the repo.
# A specific, metadata-stripped, size-checked clip can be allowed with a negation below.
doc/*.mov
doc/*.MOV
doc/*.mp4
!doc/rPlayHub-android-3d.mp4
/acastsink.tar.gz
/refs/qemu-emulator/
